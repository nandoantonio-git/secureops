# SecureOps local development environment

# PostgreSQL connection used by the API, analysis state, findings, and validation data.
DATABASE_URL=postgresql+psycopg://secureops:secureops@localhost:5432/secureops

# Gate behavior. Keep advisory as the local default; use blocking_enabled only
# when validating critical deterministic findings.
GATE_MODE=advisory

# Secondary language for minimum deterministic coverage. Python remains the
# primary language; JavaScript is the recommended secondary MVP target.
SECONDARY_LANGUAGE=javascript

# Local Ollama remediation enhancer. The service must still work when Ollama is
# unavailable by using reviewed templates and deterministic fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama
OLLAMA_TIMEOUT_SECONDS=10
OLLAMA_FALLBACK_ENABLED=true
